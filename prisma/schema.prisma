datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  fullName       String
  email          String         @unique
  password       String
  fcmToken       String?
  appleId        String?
  profileImage   String?
  profession     String?
  bio            String?
  phoneNumber    String?
  gender         Gender?
  dob            DateTime?
  address        String?
  role           UserRole
  isSetup        Boolean        @default(false)
  status         UserStatus     @default(Active)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userLocations  UserLocation[]
  playerProfile  PlayerProfile?
  coachProfile   CoachProfile?
  clubProfile    ClubProfile?
  scoutProfile   ScoutProfile?
  galleries      Gallery[]
  jobs           Job[]
  applications   Application[]
  matches        Match[]
  reviewer       Report[]       @relation("givenReport")
  receiver       Report[]       @relation("receivedReport")
  sender         Room[]         @relation("user1Relation")
  receiverr      Room[]         @relation("user2Relation")
  matchRequests  MatchRequest[]
  confirmMatches ConfirmMatch[]
  notifications  Notification[]

  @@map("users")
}

model PendingUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  fullName  String
  password  String
  otp       String
  expiresAt DateTime
  role      UserRole
  createdAt DateTime @default(now())
}

model UserLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_locations")
}

model PlayerProfile {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  userId             String     @unique @db.ObjectId
  gender             Gender
  profession         String
  subProfession      String
  city               String
  bio                String
  education          String?
  skills             String[]
  dob                String
  height             String
  weight             String
  highlights         String[]
  bestFoot           TFoot
  position           TPosition
  secondaryPosition  TPosition?
  playerCard         String
  medicalCertificate String?
  category           String
  playingStyle       String[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  player             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_profiles")
}

model CoachProfile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  coachRole      String
  city           String
  licences       String[]
  skills         String[]
  lscSenior      String
  lscYouth       String
  bio            String
  education      String?
  dob            String
  height         String
  weight         String
  coachCard      String
  expCertificate String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  coach          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coach_profiles")
}

model Gallery {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  title        String
  date         String
  galleryImage String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("galleries")
}

model ClubProfile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  clubName      String
  location      String
  bio           String
  category      String
  playingField  String?
  agonistica    String[]
  preAgonistica String[]
  socialLinks   String[]
  logo          String
  lost          Int?
  won           Int?
  members       Int?
  year          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  club          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("club_profiles")
}

model ScoutProfile {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  userId         String      @unique @db.ObjectId
  experience     String
  currentOrg     String?
  bio            String
  scoutingLevel  String[]
  specialization String[]
  evalMethod     String[]
  preferredAge   String[]
  preferredRoles TPosition[]
  licence        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  scout          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scout_profiles")
}

model Job {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  clubId         String          @db.ObjectId
  position       UserRole
  title          String
  description    String
  location       String
  latitude       Float
  longitude      Float
  employmentType TEmploymentType
  isHired        Boolean         @default(false)
  currency       String
  banner         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  club           User            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  applications   Application[]

  @@map("jobs")
}

model Application {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId     String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@map("applications")
}

model Match {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  clubId         String         @db.ObjectId
  matchType      String
  ageCategory    String
  date           String
  time           String
  location       String
  latitude       Float
  longitude      Float
  ticketPrice    Float
  additionalInfo String?
  isActive       Boolean        @default(false)
  isTeamSelect   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  club           User           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  matchRequests  MatchRequest[]
  confirmMatches ConfirmMatch[]

  @@map("matches")
}

model MatchRequest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  clubId     String   @db.ObjectId
  matchId    String   @db.ObjectId
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  club       User     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_requests")
}

model ConfirmMatch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  matchId   String   @db.ObjectId
  clubId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  club      User     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("confirm_matches")
}

model Report {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  scoutId   String   @db.ObjectId
  playerId  String   @db.ObjectId
  pace      Int
  shooting  Int
  passing   Int
  dribbling Int
  defending Int
  physical  Int
  reportUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scout     User     @relation("givenReport", fields: [scoutId], references: [id], onDelete: Cascade)
  player    User     @relation("receivedReport", fields: [playerId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  otp       String
  expiresAt DateTime
}

model Room {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String?  @db.ObjectId
  receiverId String?  @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user1      User?    @relation("user1Relation", fields: [senderId], references: [id])
  user2      User?    @relation("user2Relation", fields: [receiverId], references: [id])

  message Message[]

  @@unique([senderId, receiverId])
  @@map("rooms")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  user1Id   String   @db.ObjectId
  user2Id   String   @db.ObjectId
  content   String?
  fileUrl   String[]
  user1Read Boolean  @default(false)
  user2Read Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id])

  @@map("messages")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum UserStatus {
  Active
  Blocked
  Deleted
}

enum UserRole {
  Player
  Coach
  Club
  Scout
  Admin
}

enum Gender {
  Male
  Female
  Other
}

enum TFoot {
  Left
  Right
  Both
}

enum TEmploymentType {
  Full_Time
  Part_Time
  Contract
}

enum TPosition {
  Goalkeeper
  Left_Back
  CB_Left
  CB_Right
  Right_Back
  CM_Left
  CM_Center
  CM_Right
  Left_Winger
  Right_Winger
  Striker
}
